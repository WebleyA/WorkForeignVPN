VPN_SERVER=203.0.113.10
VPN_TYPE=l2tp-ipsec
VPN_USER=change-me-user
VPN_PASSWORD=change-me-password
VPN_L2TP_KEY=change-me-ipsec-psk

# --- Необязательные настройки, не менять ---
# Optional: pin a route to the L2TP/IPsec server through the Docker gateway.
# Leave empty in most cases; the entrypoint detects the default gateway.
HOST_GATEWAY=
# Optional: leave empty to generate a UUID for the lifetime of the container.
VLESS_UUID=
# IPv4 DNS used by Xray through L2TP; use the VPN DNS for private names.
VPN_DNS=1.1.1.1
# Host port; Xray always listens on 1081 inside the container.
VLESS_PORT=1081